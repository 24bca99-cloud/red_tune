# RedTune Server Environment Configuration
# Required for YouTube Data API v3 search (Server-side ONLY; never exposed to browser)
# Normal listeners/users do NOT need an API key. Only developer/host sets this.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Local backend port (Default: 5000)
PORT=5000

# JWT signing secret for authentication tokens (Set a strong random key in production)
JWT_SECRET=redtune_jwt_production_secret_key_change_me
